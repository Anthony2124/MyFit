{
  "name": "Steady — habits, mood, sleep & fitness",
  "short_name": "Steady",
  "description": "A private tracker for daily habits, mood, sleep, water and workouts.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f6f5f1",
  "theme_color": "#4f8a6e",
  "categories": ["health", "fitness", "lifestyle", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Log mood", "url": "/mood", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log workout", "url": "/fitness", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Log sleep", "url": "/sleep", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Breathe", "url": "/calm", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
